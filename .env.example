# Orkes Developer Edition (or any Orkes Conductor cluster). Create an application under
# Access Control > Applications, then create an access key for it.
CONDUCTOR_SERVER_URL=https://developer.orkescloud.com/api
CONDUCTOR_AUTH_KEY=your-key-id
CONDUCTOR_AUTH_SECRET=your-key-secret

# Optional: owner email stamped on the workflow and task definitions
CONDUCTOR_OWNER_EMAIL=you@example.com

# Optional: UI server port (it only listens on 127.0.0.1)
PORT=5173

# Optional: the Conductor secret that holds your Mistral API key (default: mistral_api_key)
# MISTRAL_SECRET_NAME=mistral_api_key
